{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Architect-RR/phinix-public/interfaces/credential_boundary_summary.schema.json",
  "title": "PHINIX Public Credential Boundary Summary",
  "description": "Public-safe shape for credential boundary posture. This schema must not contain secrets, token values, device identifiers, or provisioning instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "boundary_id",
    "credential_surface",
    "storage_policy",
    "public_release_policy",
    "rotation_state",
    "disclosure_policy"
  ],
  "properties": {
    "x_phinix_marker": {
      "type": "string",
      "const": "# ⭐ 修改開始/結束 ⭐ public-safe schema skeleton"
    },
    "schema": {
      "type": "string",
      "const": "phinix_public_credential_boundary_summary"
    },
    "boundary_id": {
      "type": "string"
    },
    "credential_surface": {
      "type": "string"
    },
    "storage_policy": {
      "type": "string"
    },
    "public_release_policy": {
      "type": "string"
    },
    "rotation_state": {
      "type": "string",
      "enum": [
        "unknown",
        "local_operator_required",
        "rotated_private",
        "not_applicable"
      ]
    },
    "disclosure_policy": {
      "type": "string"
    },
    "public_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
